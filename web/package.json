{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:prod": "playwright test --config=playwright.prod.ts",
    "gen:glossary": "vitest run src/lib/glossary.test.ts --update",
    "gen:cheatsheets": "vitest run src/lib/cheatsheets/render.test.ts --update",
    "gen:highlighted": "vitest run src/lib/cheatsheets/generate-highlighted.test.ts --update",
    "prepare": "lefthook install || true",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:dev-console": "playwright test --config=playwright.dev.ts"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  }
}
